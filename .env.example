# Supabase — pega em Project Settings → API
# A anon key é pública por design (vai pro bundle do client). O que protege os dados é RLS.
# Copie esse arquivo pra .env.local e preencha. .env.local é gitignored.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sentry — pega em Project Settings → Client Keys (DSN). Vazio = sem reporting.
VITE_SENTRY_DSN=

# Cloudflare Web Analytics — pega no dashboard CF, em Web Analytics → Site → Token.
# Vazio = sem beacon (zero requests externos). Pageviews + Core Web Vitals só.
VITE_CF_BEACON_TOKEN=
