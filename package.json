{
  "name": "draft26",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "setup:e2e": "playwright install chromium",
    "test:e2e": "playwright install chromium && playwright test",
    "test:e2e:ui": "playwright install chromium && playwright test --ui",
    "sim:distortions": "playwright install chromium && playwright test e2e/distortions.spec.ts",
    "scrape:squads": "tsx scripts/scrape-squads.ts",
    "enrich:squads": "tsx scripts/enrich-squads.ts",
    "download:fifa": "tsx scripts/download-fifa-dataset.ts",
    "download:transfermarkt": "tsx scripts/download-transfermarkt.ts",
    "enrich:fifa": "tsx scripts/enrich-with-fifa.ts",
    "enrich:transfermarkt": "tsx scripts/enrich-with-transfermarkt.ts",
    "enrich:alt-positions": "tsx scripts/enrich-alt-positions.ts",
    "recalibrate:heuristic": "tsx scripts/recalibrate-heuristic.ts",
    "download:matches": "tsx scripts/download-matches.ts",
    "calibrate:sim": "tsx scripts/calibrate-sim.ts",
    "data:rebuild": "pnpm scrape:squads && pnpm enrich:squads && pnpm download:fifa && pnpm enrich:fifa && pnpm download:transfermarkt && pnpm enrich:transfermarkt && pnpm enrich:alt-positions && pnpm recalibrate:heuristic && pnpm download:matches && pnpm calibrate:sim"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.8",
    "cheerio": "^1.2.0",
    "papaparse": "^5.5.3",
    "supabase": "^2.105.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.22.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.8"
  }
}
